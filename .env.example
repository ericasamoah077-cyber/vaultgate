# --- Database (added automatically when you connect a Neon Postgres database in Vercel > Storage)
DATABASE_URL=

# --- Secrets: make each one long and random, e.g.  openssl rand -base64 48
PEPPER=
JWT_SECRET=
BACKUP_KEY=
CRON_SECRET=

# --- Cloud backup (added automatically when you create and connect a Vercel Blob store)
BLOB_READ_WRITE_TOKEN=

# --- Email for sign-in codes: send from your own Gmail (no domain needed)
# SMTP_PASS is a Google "App Password" (16 letters), NOT your normal Gmail password.
SMTP_USER=yourname@gmail.com
SMTP_PASS=
# Optional: name shown on the emails (Gmail always sends from the SMTP_USER address)
EMAIL_FROM=VaultGate <yourname@gmail.com>
# Alternative to Gmail: Resend (needs a verified domain to email other people)
# RESEND_API_KEY=

# --- Public sign-up: set to false to stop people creating their own accounts (admins can still add members)
ALLOW_REGISTRATION=true

# --- First admin account (created on the first request if no admin exists yet)
ADMIN_NAME=Site Admin
# Use a real inbox: the sign-in code is emailed here
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=
